AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_AGENT_UID=123456
AGORA_AREA=NORTH_AMERICA
ASR_MODEL=nova-3
LLM_MODEL=gpt-4o-mini
TTS_MODEL=speech_2_6_turbo
TTS_VOICE_ID=English_captivating_female1
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*
TOKEN_EXPIRY_SECONDS=3600
SESSION_TTL_SECONDS=7200
REQUESTS_PER_MINUTE=60

# MCP tool-calling (see app/mcp/tool_server.py). This MUST be a publicly
# reachable HTTPS URL -- Agora's own servers call it, not your phone or
# browser -- so during local dev it needs the SAME tunnel URL you already
# use for the Android app itself (see docs/local-tunnels.md). Leave blank
# to disable tool-calling entirely; the coach agent then runs exactly as
# it did before this feature existed.
MCP_TOOL_SERVER_PUBLIC_URL=
ENABLE_AGENT_TOOL_CALLING=true
